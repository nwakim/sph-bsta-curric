<script>
(function () {
  var cx = 450, cy = 450;
  var ringR = 235;      // stage label ring (must stay well inside circleR once label width is added)
  var circleR = 350;    // filled blue lifecycle circle
  var badgeR = 405;     // course badge ring (outside the blue circle)
  var ethicsTextR = 460; // ethics dimension label radius (outside badges)

  function toRad(deg) { return (deg - 90) * Math.PI / 180; } // -90 so 0deg = top
  function polar(r, deg) {
    var a = toRad(deg);
    return { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) };
  }

  var stages = [
    { id: "design", label: ["Project motivation", "and design"],
      primary: ["BSTA 517", "BSTA 523", "BSTA 535"], related: ["BSTA 511", "BSTA 512", "BSTA 513", "BSTA 514"] },
    { id: "collect", label: ["Data collection", "and sourcing"],
      primary: ["BSTA 511", "BSTA 512", "BSTA 513", "PUBH 523", "BSTA 535"], related: ["BSTA 514", "BSTA 519"] },
    { id: "clean", label: ["Data cleaning and", "preparation"],
      primary: ["BSTA 511", "BSTA 512", "BSTA 513", "BSTA 526", "PUBH 523", "BSTA 535"], related: [] },
    { id: "explore", label: ["Data exploration", "and visualization"],
      primary: ["BSTA 511", "BSTA 512", "BSTA 513", "BSTA 526", "PUBH 523", "BSTA 535", "BSTA 514", "BSTA 519", "BMI 525"], related: [] },
    { id: "model", label: ["Modeling, algorithms,", "machine learning"],
      primary: ["BSTA 511", "BSTA 512", "BSTA 513", "BSTA 551", "BSTA 535", "BSTA 514", "BSTA 519"], related: ["BSTA 550"] },
    { id: "disseminate", label: ["Dissemination and/or", "deployment"],
      primary: [], related: ["BSTA 512", "BSTA 513", "PUBH 523", "BSTA 535"],
      note: "Idea: bring in a lab or collaborative course tied to a consulting-style experience (not formal consulting) to build real coverage here." },
    { id: "monitor", label: ["Monitoring and", "feedback"],
      primary: [], related: [],
      gap: "No course currently covers post-deployment monitoring or feedback loops, and it's unclear whether feedback ever routes back into new project design and motivation. Idea: a communication-focused guest lecture from Health Data Sciences (HDS) to start covering this stage." }
  ];

  var courseNames = {
    "BSTA 511": "Estimation & Hypothesis Testing", 
    "BSTA 512": "Linear Models", 
    "BSTA 513": "Categorical Data Analysis",
    "BSTA 514": "Statistical Analysis of Time-to-Event Data.",
    "BSTA 517": "Statistical Methods in Clinical Trial Design.",
    "BSTA 519": "Applied Longitudinal Data Analysis.",
    "BSTA 523": "Design of Experiments.",
    "BSTA 526": "R Programming for Health Data Science.",
    "BSTA 535": "Biostatistics Capstone.",
    "BSTA 550": "Introduction to Probability.",
    "BSTA 551": "Theory of Statistical Inference I.",
    "PUBH 523": "Introduction to R",
    "BMI 525": "Biomedical Informatics course outside the BSTA prefix (title to be confirmed)."
  };

  var ethicsDims = [
    { label: "Fairness", note: "No notes yet — open question for curriculum discussion." },
    { label: "Transparency", note: "Ethics and reproducibility." },
    { label: "Generalizability", note: "BSTA 535 capstone: exercises using All of Us sample subsets with wearable-device data." },
    { label: "Sustainability", note: "Infrastructure and deliverables — consider building in planned updates over time." },
    { label: "Accountability", note: "Integrity and the responsibility of the statistician or investigator." }
  ];

  var svg = document.getElementById("dsl-svg");
  var NS = "http://www.w3.org/2000/svg";
  function el(tag, attrs) {
    var e = document.createElementNS(NS, tag);
    for (var k in attrs) e.setAttribute(k, attrs[k]);
    return e;
  }

  // defs: arrowhead marker
  var defs = el("defs", {});
  var marker = el("marker", { id: "dsl-arrow", markerWidth: 8, markerHeight: 8, refX: 6, refY: 3, orient: "auto", markerUnits: "strokeWidth" });
  var arrowPath = el("path", { d: "M0,0 L6,3 L0,6 Z", fill: "#ffffff" });
  marker.appendChild(arrowPath);
  defs.appendChild(marker);
  svg.appendChild(defs);

  // background lifecycle circle
  svg.appendChild(el("circle", { cx: cx, cy: cy, r: circleR, fill: "#54A4DB" }));
  var titleText = el("text", { x: cx, y: cy - 8, "text-anchor": "middle", "font-size": "24", "font-weight": "600", fill: "#ffffff", "font-family": "Noto Sans, Arial, sans-serif" });
  titleText.textContent = "Data Science";
  svg.appendChild(titleText);
  var titleText2 = el("text", { x: cx, y: cy + 20, "text-anchor": "middle", "font-size": "24", "font-weight": "600", fill: "#ffffff", "font-family": "Noto Sans, Arial, sans-serif" });
  titleText2.textContent = "Lifecycle";
  svg.appendChild(titleText2);

  var n = stages.length;
  var step = 360 / n;
  var startAngle = -75; // degrees, tuned to roughly match the original hand-drawn layout

  function angleFor(i) { return startAngle + i * step; }

  // connector arcs between stages (drawn first, under labels) — purely directional, no gap semantics
  for (var i = 0; i < n; i++) {
    var a1 = angleFor(i), a2 = angleFor(i + 1);
    var p1 = polar(ringR + 34, a1 + 10);
    var p2 = polar(ringR + 34, a2 - 10);
    var path = el("path", {
      d: "M " + p1.x.toFixed(1) + " " + p1.y.toFixed(1) + " A " + (ringR + 34) + " " + (ringR + 34) + " 0 0 1 " + p2.x.toFixed(1) + " " + p2.y.toFixed(1),
      fill: "none",
      stroke: "#ffffff",
      "stroke-width": 3,
      "marker-end": "url(#dsl-arrow)",
      opacity: 0.95
    });
    svg.appendChild(path);
  }

  // outer ethics ring (labels only, tangent-rotated straight text approximating the curved arc)
  var ethicsStep = 360 / ethicsDims.length;
  var ethicsStart = -60;
  ethicsDims.forEach(function (dim, i) {
    var ang = ethicsStart + i * ethicsStep;
    var pos = polar(ethicsTextR, ang);
    var rot = ang; // tangent-ish rotation
    if (rot > 90 && rot < 270) rot += 180; // keep text upright
    var g = el("g", { class: "dsl-ethics-hit", "data-label": dim.label, "data-note": dim.note, tabindex: "0", transform: "translate(" + pos.x.toFixed(1) + "," + pos.y.toFixed(1) + ") rotate(" + rot.toFixed(1) + ")" });
    var t = el("text", { "text-anchor": "middle", "font-size": "15", "font-weight": "600", fill: "#07476F", "font-family": "Noto Sans, Arial, sans-serif", "letter-spacing": "0.03em" });
    t.textContent = dim.label;
    g.appendChild(t);
    svg.appendChild(g);
    attachHover(g, function (d) {
      return function () { return { title: d.label, body: "<div class='dsl-idea-note' style='margin-top:0'>" + d.note + "</div>" }; };
    }(dim));
  });

  // stage nodes + badges
  stages.forEach(function (stage, i) {
    var ang = angleFor(i);
    var pos = polar(ringR, ang);
    var badgePos = polar(badgeR, ang);

    // connector line stage -> badge
    svg.appendChild(el("line", { x1: pos.x, y1: pos.y, x2: badgePos.x, y2: badgePos.y, stroke: "#dfd7ca", "stroke-width": 1.5 }));

    // stage hit area
    var g = el("g", { class: "dsl-stage-hit", "data-stage": stage.id, tabindex: "0" });
    g.appendChild(el("circle", { class: "dsl-stage-bg", cx: pos.x, cy: pos.y, r: 46, fill: "#07476F", opacity: 0.001 }));
    var label = el("text", { class: "dsl-stage-label", x: pos.x, y: pos.y - 4, "text-anchor": "middle", "font-family": "Noto Sans, Arial, sans-serif" });
    stage.label.forEach(function (line, li) {
      label.appendChild(el("tspan", { x: pos.x, dy: li === 0 ? 0 : 14 }, )).textContent = line;
    });
    g.appendChild(label);
    svg.appendChild(g);

    var count = stage.primary.length;
    var hasRelated = stage.related.length > 0;
    var badgeColor = stage.gap ? "#F79226" : (count > 0 ? "#00814A" : "#818385");
    var bg = el("g", { class: "dsl-badge", "data-stage": stage.id, tabindex: "0" });
    bg.appendChild(el("circle", { class: "dsl-badge-ring", cx: badgePos.x, cy: badgePos.y, r: 20, fill: badgeColor, stroke: "#ffffff", "stroke-width": 2 }));
    if (hasRelated) {
      bg.appendChild(el("circle", { cx: badgePos.x, cy: badgePos.y, r: 26, fill: "none", stroke: "#818385", "stroke-width": 2, "stroke-dasharray": "3 3" }));
    }
    var bt = el("text", { x: badgePos.x, y: badgePos.y + 5, "text-anchor": "middle" });
    bt.textContent = stage.gap ? "—" : String(count);
    bg.appendChild(bt);
    svg.appendChild(bg);

    function activate(node) {
      Array.prototype.forEach.call(document.querySelectorAll(".is-active"), function (n) { n.classList.remove("is-active"); });
      document.querySelectorAll('[data-stage="' + stage.id + '"]').forEach(function (n) { n.classList.add("is-active"); });
    }

    function renderPanel() {
      var body = "";
      if (stage.primary.length || stage.related.length) {
        if (stage.primary.length) {
          body += "<div class='dsl-panel-section'><h4>Primary coverage</h4><ul class='dsl-course-list'>" +
            stage.primary.map(function (c) { return "<li><span class='dsl-course-code'>" + c + "</span><span>" + (courseNames[c] || "") + "</span></li>"; }).join("") +
            "</ul></div>";
        }
        if (stage.related.length) {
          body += "<div class='dsl-panel-section'><h4>Related / partial coverage</h4><ul class='dsl-course-list'>" +
            stage.related.map(function (c) { return "<li><span class='dsl-course-code'>" + c + "</span><span>" + (courseNames[c] || "") + "</span></li>"; }).join("") +
            "</ul></div>";
        }
      } else {
        body += "<p class='dsl-panel-hint'>No courses currently map to this stage.</p>";
      }
      if (stage.gap) {
        body += "<div class='dsl-gap-note'><strong>Possible gap:</strong> " + stage.gap + "</div>";
      }
      if (stage.note) {
        body += "<div class='dsl-idea-note'><strong>Curriculum idea:</strong> " + stage.note + "</div>";
      }
      document.getElementById("dsl-panel-title").textContent = stage.label.join(" ");
      document.getElementById("dsl-panel-hint").style.display = "none";
      document.getElementById("dsl-panel-body").innerHTML = body;
    }

    [g, bg].forEach(function (node) {
      node.addEventListener("mouseenter", function () { activate(node); renderPanel(); showTooltipFor(node, stage); });
      node.addEventListener("mouseleave", hideTooltip);
      node.addEventListener("focus", function () { activate(node); renderPanel(); showTooltipFor(node, stage); });
      node.addEventListener("blur", hideTooltip);
      node.addEventListener("click", function () { activate(node); renderPanel(); });
    });
  });

  function showTooltipFor(target, stage) {
    var lines = [];
    if (stage.primary.length) lines.push("<strong>Primary:</strong> " + stage.primary.join(", "));
    if (stage.related.length) lines.push("<strong>Related:</strong> " + stage.related.join(", "));
    if (!stage.primary.length && !stage.related.length) lines.push(stage.gap ? "No courses currently map here." : "No courses mapped.");
    if (stage.gap) lines.push("<em>⚠ Flagged as a possible gap</em>");
    else if (stage.note) lines.push("<em>💡 Curriculum idea noted</em>");
    showTooltip(target, "<span class='dsl-tt-title'>" + stage.label.join(" ") + "</span>" + lines.join("<br>"));
  }

  var tooltip = document.getElementById("dsl-tooltip");
  function attachHover(node, getContent) {
    function handler() {
      var c = getContent();
      showTooltip(node, "<span class='dsl-tt-title'>" + c.title + "</span>" + c.body);
      document.getElementById("dsl-panel-title").textContent = c.title;
      document.getElementById("dsl-panel-hint").style.display = "none";
      document.getElementById("dsl-panel-body").innerHTML = c.body;
    }
    node.addEventListener("mouseenter", handler);
    node.addEventListener("focus", handler);
    node.addEventListener("mouseleave", hideTooltip);
    node.addEventListener("blur", hideTooltip);
  }

  function showTooltip(target, html) {
    tooltip.innerHTML = html;
    tooltip.classList.add("is-visible");
    var rect = target.getBoundingClientRect();
    var top = rect.bottom + 8;
    var left = rect.left;
    var ttRect = tooltip.getBoundingClientRect();
    if (left + ttRect.width > window.innerWidth - 12) left = window.innerWidth - ttRect.width - 12;
    if (top + ttRect.height > window.innerHeight - 12) top = rect.top - ttRect.height - 8;
    tooltip.style.top = top + "px";
    tooltip.style.left = Math.max(12, left) + "px";
  }
  function hideTooltip() { tooltip.classList.remove("is-visible"); }
})();
</script>
